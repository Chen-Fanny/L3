# Taiwan CWA OpenData API Key (Get free key from https://opendata.cwa.gov.tw/)
CWA_API_KEY=

# CWA Dataset URL (O-A0001-001: Automatic Weather Station observation)
CWA_DATA_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore/O-A0001-001

# Cache time to live in seconds (Default: 10 minutes = 600 seconds)
CACHE_TTL_SECONDS=600

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=*
